{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[MacOS] Jekyll: Serve",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "PATH=\"$(brew --prefix ruby@3.3)/bin:$PATH\" bundle exec jekyll serve"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Generating\\.\\.\\..*$",
          "endsPattern": "^.*Server running\\.\\.\\..*$"
        }
      }
    },
    {
      "label": "[Linux] Jekyll: Serve",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "-lc",
        "bundle exec jekyll serve"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Generating\\.\\.\\..*$",
          "endsPattern": "^.*Server running\\.\\.\\..*$"
        }
      }
    }
  ]
}